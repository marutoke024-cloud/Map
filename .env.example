# --- HotPepper Gourmet (Recruit Web Service) ---
# Register for a free key: https://webservice.recruit.co.jp/
# Used server-side only (injected by the /api/hotpepper proxy). Never exposed to the browser.
HOTPEPPER_API_KEY=

# --- Firebase (optional) ---
# If omitted, pins are stored in the browser's localStorage so the app still works.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
